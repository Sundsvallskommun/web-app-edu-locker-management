{
  "name": "lockermanagement",
  "version": "1.0.0",
  "description": "Locker management app for schools",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "generate:contracts": "cross-env NODE_ENV=development npx tsx ./src/swagger-typescript-api.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "type-check": "tsc --pretty --noEmit",
    "analyze": "cross-env ANALYZE=true next build",
    "analyze:server": "cross-env BUNDLE_ANALYZE=server next build",
    "analyze:browser": "cross-env BUNDLE_ANALYZE=browser next build",
    "cypress": "cypress open",
    "cypress:headless": "cypress run --e2e"
  },
  "dependencies": {
    "@next/bundle-analyzer": "16.2.12",
    "@sk-web-gui/core": "^4.6.2",
    "@sk-web-gui/react": "^3.1.3",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "i18next": "^25.10.10",
    "i18next-resources-to-backend": "^1.2.3",
    "lucide-react": "^0.542.0",
    "next": "16.2.12",
    "next-i18n-router": "^5.5.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^15.7.4",
    "sass": "^1.106.0",
    "sharp": "^0.35.5",
    "underscore.string": "^3.3.6",
    "usehooks-ts": "^3.1.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/underscore.string": "^0.0.41",
    "autoprefixer": "^10.6.1",
    "cross-env": "^10.1.0",
    "cypress": "^15.21.1",
    "dotenv": "^17.4.2",
    "envalid": "^8.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.31",
    "postcss-import": "^16.2.0",
    "prettier": "^3.9.10",
    "swagger-typescript-api": "^13.13.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "postcss": "^8.5.31",
    "sharp": "^0.35.5"
  }
}
